# Google Forms credentials
# The client resolves these in this order (see
# src/api/google_forms_client_production.py lines 97 and 107).
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_CREDENTIALS_FILE=credentials.json

# Tallyfy credentials
TALLYFY_API_KEY=your_tallyfy_api_key_here
TALLYFY_ORGANIZATION=your_organization_subdomain
# Base URL only. The client appends /api itself, so do NOT include it here.
TALLYFY_API_URL=https://api.tallyfy.com

# AI augmentation (optional -- deterministic fallbacks run without it)
ANTHROPIC_API_KEY=sk-ant-api03-...
AI_MODEL=claude-3-haiku-20240307
AI_TEMPERATURE=0
AI_MAX_TOKENS=500
